<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The default encoder hands dictionaries to zstd as a raw prefix, which needs the low-level zstd API. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>ChunkShift.Patching</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Verified binary patches over ChunkShift manifests: reuse planning, CSP patch creation and verified reconstruction for .NET.</Description>
    <Authors>MrFr3di</Authors>
    <Copyright>Copyright (c) 2026 MrFr3di</Copyright>
    <PackageProjectUrl>https://github.com/MrFr3di/ChunkShift</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MrFr3di/ChunkShift</RepositoryUrl>
    <PackageTags>patching;binary-delta;delta-update;chunking;content-addressing;zstd;manifest</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChunkShift.Patching.Tests" />
    <ProjectReference Include="..\ChunkShift\ChunkShift.csproj" />
    <PackageReference Include="Blake3" />
    <PackageReference Include="ZstdSharp.Port" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <!-- Rendered by nuget.org, so it uses absolute links: repository-relative paths do not resolve there. -->
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

</Project>
